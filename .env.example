# Copy to ~/.meeting-ledger/.env (or a .env in the folder you run from).

# Required for `add` and `ask`: Claude extracts items and answers questions.
ANTHROPIC_API_KEY=sk-ant-...

# The decision model that checks Claude's work. Pick one (or none):
#  - Kev, the open-source Jev, running on your own machine (see README):
TYPESAFE_BASE_URL=
TYPESAFE_MODEL=kev-latest
#  - Jev, TypeSafe's hosted model (early access):
TYPESAFE_API_KEY=
#  - neither: TypeSafe's open-source adapter asks Claude Haiku the same questions.

# Write every new meeting into an Obsidian vault as a note.
OBSIDIAN_VAULT=
OBSIDIAN_FOLDER=Meetings

# Tuning
STALE_AFTER=2          # meetings with an item's owner that never mention it before it counts as stale
MIN_CONFIDENCE=0.7     # below this, a status change goes to review instead of being applied
MEETING_LEDGER_MODEL=claude-opus-5-5
